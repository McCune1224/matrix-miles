// WiFi Configuration Example
// Copy this file to config.hpp and fill in your actual values
// DO NOT commit config.hpp to git!

#ifndef CONFIG_HPP
#define CONFIG_HPP

// WiFi Credentials - Replace with your actual WiFi network details
const char* WIFI_SSID = "your_wifi_ssid_here";
const char* WIFI_PASSWORD = "your_wifi_password_here";

// API Configuration - Replace with your actual API key
#define ESP32_API_KEY "your_api_key_here"

// Server Configuration - Base URL (no trailing slash)
// Example for local network server:
// const char* SERVER_BASE_URL = "http://192.168.68.100:8080/api";
// Example for remote server:
// const char* SERVER_BASE_URL = "http://your-server.com:8080/api";
const char* SERVER_BASE_URL = "http://your-server-ip:8080/api";

// User ID for API requests
const int USER_ID = 1;

#endif // CONFIG_HPP
